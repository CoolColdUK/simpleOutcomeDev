# Copy to `packages/sites/.env.local` for local dev.
# Leave the Supabase pair empty to render the three bundled demos on *.localhost.
# Preset previews (local only, same fallback): preview-home-studio.localhost, and the other preset ids.
# To use the admin, drafts, and published sites locally, set the staging Supabase URL, anon key, and secret key.
# Do not put production keys here. GitHub stores those staging values as *_STAGE variables and secrets.
# Do not prefix the server secrets with NEXT_PUBLIC_.

# The API URL is https://$SUPABASE_PROJECT_REF.supabase.co.
# GitHub stores the ref as SUPABASE_PROJECT_REF_STAGE. Leave the ref empty for file demos.
SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hosts under this domain (*.simpleoutcome.dev) and *.localhost stay noindex.
# A live site on its own domain is indexable. The request host is the canonical URL.
# admin.simpleoutcome.dev / admin.localhost is the production editor (noindex).
# Staging editor is admindev.simpleoutcome.dev.
# Optional document.seo (title, description, locale, ogImageUrl, googleBusinessProfileUrl, geo) has no env var.
NEXT_PUBLIC_SITES_ROOT_DOMAIN=simpleoutcome.dev
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional. Inlined at build time. Defaults to info@simpleoutcome.dev.
# NEXT_PUBLIC_SITES_SALES_EMAIL=info@simpleoutcome.dev

# Server only. Staging secret key (same value as GitHub secret SUPABASE_SECRET_KEY_STAGE).
# Required for drafts, published custom domains, admin editor, and site MCP.
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SITES_IP_HASH_PEPPER=
