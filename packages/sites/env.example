# Copy to `packages/sites/.env.local` for local dev.
# Leave the Supabase pair empty to render the three bundled demos on *.localhost.
# Preset previews (local only, same fallback): preview-home-studio.localhost, and the other preset ids.
# Production builds take these values from GitHub during Sites production.
# Do not set them on the Vercel project. Do not prefix the server secrets with NEXT_PUBLIC_.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Hosts under this domain (*.simpleoutcome.dev) and *.localhost stay noindex.
# A live site on its own domain is indexable. Canonical URL is public.site.custom_domain, not an env var.
# Optional document.seo (title, description, locale, ogImageUrl, googleBusinessProfileUrl, geo) has no env var.
NEXT_PUBLIC_SITES_ROOT_DOMAIN=simpleoutcome.dev
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional. Inlined at build time. Defaults to info@simpleoutcome.dev.
# NEXT_PUBLIC_SITES_SALES_EMAIL=info@simpleoutcome.dev

# Server only. Empty locally until you want to send a real enquiry.
SUPABASE_SECRET_KEY=
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SITES_IP_HASH_PEPPER=
