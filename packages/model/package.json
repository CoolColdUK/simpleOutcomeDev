{
  "private": true,
  "name": "@so/model",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "scripts": {
    "build": "tsdown",
    "build:prod": "tsdown",
    "build:staging": "tsdown",
    "clean:dist": "rm -rf dist && rm -rf tsconfig.tsbuildinfo",
    "clean:node": "rm -rf node_modules",
    "lint": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest"
  },
  "types": "dist/index.d.mts",
  "sideEffects": false,
  "dependencies": {
    "tsdown": "^0.22.14",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@coolcolduk/jest-config": "^6",
    "@coolcolduk/ts-config": "^6",
    "@types/node": "^24.13.2",
    "typescript": "^6"
  },
  "engines": {
    "node": "24"
  },
  "jest": {
    "preset": "@coolcolduk/jest-config",
    "rootDir": "./src"
  }
}
