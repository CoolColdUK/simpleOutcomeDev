# Copy to `packages/web/.env.local` for local dev.
# Vercel: set these on the production project (and locally before `npm run build`).

# Canonical site URL (SEO, sitemap, robots).
NEXT_PUBLIC_WEB_URL=https://simpleoutcome.dev

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret key (Project Settings → API). Required for /api/mcp and agent REST.
# Do not prefix with NEXT_PUBLIC_. The settings UI creates keys with the signed-in session.
SUPABASE_SECRET_KEY=

# Build identity (set by the production GitHub Actions workflow)
# NEXT_PUBLIC_APP_VERSION=0.1.0
# NEXT_PUBLIC_GIT_COMMIT=abc1234
