# Copy to `packages/web/.env.local` for local dev.
# Use the staging Supabase project (the same one Actions → Staging migrates). Do not put production keys here.
# The app reads these names. GitHub stores the same values as *_STAGE variables and secrets.

# Canonical site URL is https://$NEXT_PUBLIC_SITES_ROOT_DOMAIN (SEO, sitemap, robots).
# Local dev uses the staging root domain. GitHub stores it as NEXT_PUBLIC_SITES_ROOT_DOMAIN_STAGE.
NEXT_PUBLIC_SITES_ROOT_DOMAIN=stage.simpleoutcome.dev

# Staging Supabase. The API URL is https://$SUPABASE_PROJECT_REF.supabase.co.
# GitHub stores the ref as SUPABASE_PROJECT_REF_STAGE.
SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Staging secret key (Project Settings → API). Same value as GitHub secret SUPABASE_SECRET_KEY_STAGE.
# Required for /api/mcp and agent REST. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Build identity (set by the production GitHub Actions workflow)
# NEXT_PUBLIC_APP_VERSION=0.1.0
# NEXT_PUBLIC_GIT_COMMIT=abc1234
